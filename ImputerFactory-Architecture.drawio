                </mxCell>
                <mxCell id="principle1" value="1. &lt;b&gt;CPU Planning, GPU Execution&lt;/b&gt; — Segmenters plan layouts once on CPU; mask generation runs in bulk on GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#c0cfe0;fontSize=11;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="1065" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="principle2" value="2. &lt;b&gt;Typed Read‑Only Configs&lt;/b&gt; — SegmenterConfig and MaskerConfig carry typed params; Factory enriches model metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#c0cfe0;fontSize=11;align=left;" parent="1" vertex="1">
                    <mxGeometry x="580" y="1065" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="principle3" value="3. &lt;b&gt;Strict Boundary Rules&lt;/b&gt; — Only Imputer touches model; Game never imports torch; Masker clones inputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#c0cfe0;fontSize=11;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="1105" width="500" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="principle4" value="4. &lt;b&gt;Pluggable Architecture&lt;/b&gt; — Segmenters and Maskers are registered via decorator and resolved by string name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#c0cfe0;fontSize=11;align=left;" parent="1" vertex="1">
